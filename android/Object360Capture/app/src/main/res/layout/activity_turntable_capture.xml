<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/turntablePreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="performance"
        app:scaleType="fillCenter" />

    <ImageView
        android:id="@+id/turntableGhostOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.20"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <ru.specdpo.object360.CoverageOverlay
        android:id="@+id/turntableCoverageOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/turntableTopPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <Button
                android:id="@+id/btnTurntableBack"
                android:layout_width="52dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_button"
                android:text="←"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/turntableStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Поворотный стол"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/turntableProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 / 36"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnTurntableAngle"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_button"
                    android:text="ШАГ: 10°"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnTurntableInterval"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_button"
                    android:text="ИНТЕРВАЛ: 3 С"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnTurntableOrientation"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_button"
                    android:text="ОРИЕНТАЦИЯ: АВТО"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnTurntableGhost"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_button"
                    android:text="GHOST: 20%"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnTurntableHideUi"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_button"
                    android:text="СКРЫТЬ UI"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/turntableBottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/turntableHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_panel"
            android:gravity="center"
            android:maxWidth="360dp"
            android:paddingHorizontal="13dp"
            android:paddingVertical="8dp"
            android:text="Телефон неподвижен. Поворачивайте объект на заданный шаг."
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTurntableProcess"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_button"
            android:text="ОБРАБОТКА СЕРИИ"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTurntableReview"
                android:layout_width="74dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_button"
                android:text="3D"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnTurntableManual"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_shutter"
                android:contentDescription="Ручной кадр"
                android:text="" />

            <Button
                android:id="@+id/btnTurntableStart"
                android:layout_width="104dp"
                android:layout_height="54dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button"
                android:text="СТАРТ"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTurntableExport"
                android:layout_width="66dp"
                android:layout_height="54dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button"
                android:text="ZIP"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/turntableCleanControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <TextView
            android:id="@+id/turntableCleanStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_panel"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"
            android:text="0 / 36"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTurntableShowUi"
            android:layout_width="58dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_button"
            android:text="UI"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTurntableCleanManual"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_shutter"
            android:contentDescription="Ручной кадр без интерфейса"
            android:text="" />
    </FrameLayout>

</FrameLayout>
